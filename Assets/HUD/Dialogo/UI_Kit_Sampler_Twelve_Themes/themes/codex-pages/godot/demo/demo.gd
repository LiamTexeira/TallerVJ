extends Control
## Codex Pages UI Kit demo: builds the kit's controls with the PIXEL theme (rendered at 1x in a SubViewport and scaled 3x
## nearest-neighbour) and, when present, again with the HD theme at 1x. Every block checks the theme has the types it
## uses, so the same script runs the full kit and the free sampler. Generated by CSAF uikit_gen.js.
##   run:        godot --path <this folder>
##   screenshot: godot --path <this folder> -- --shot=<absolute png path>
## Copyright (c) 2026 Core Systems Asset Factory.

const PIXEL_THEME := "res://uikit/codex-pages/pixel/theme_pixel.tres"
const HD_THEME := "res://uikit/codex-pages/hd/theme_hd.tres"
var themed := 0
var expected := 0

func _ready() -> void:
    var bg := ColorRect.new()
    bg.color = Color("#1f2b28")
    bg.set_anchors_preset(Control.PRESET_FULL_RECT)
    add_child(bg)
    var row := HBoxContainer.new()
    row.position = Vector2(16, 16)
    row.add_theme_constant_override("separation", 24)
    add_child(row)
    var svc := SubViewportContainer.new()
    svc.stretch = true
    svc.stretch_shrink = 3
    svc.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    svc.custom_minimum_size = Vector2(800, 1050)
    row.add_child(svc)
    var sv := SubViewport.new()
    sv.transparent_bg = true
    sv.canvas_item_default_texture_filter = Viewport.DEFAULT_CANVAS_ITEM_TEXTURE_FILTER_NEAREST
    svc.add_child(sv)
    _build(sv, load(PIXEL_THEME), 1)
    if ResourceLoader.exists(HD_THEME):
        var hd := Control.new()
        hd.custom_minimum_size = Vector2(800, 1050)
        row.add_child(hd)
        _build(hd, load(HD_THEME), 3)
    var shot := ""
    for a in OS.get_cmdline_user_args():
        if a.begins_with("--shot="):
            shot = a.substr(7)
    if shot != "":
        await get_tree().process_frame
        await get_tree().process_frame
        await get_tree().process_frame
        await RenderingServer.frame_post_draw
        _count(self)
        var img := get_viewport().get_texture().get_image()
        var err := img.save_png(shot)
        print("UIKIT_THEMED|%d|%d" % [themed, expected])
        print("UIKIT_SHOT|%s|%d|%d|%s" % ["ok" if err == OK else "error %d" % err, img.get_width(), img.get_height(), shot])
        get_tree().quit(0 if err == OK else 3)

func _count(n: Node) -> void:
    for c in n.get_children():
        if c is Button or c is PanelContainer or c is LineEdit or c is ProgressBar:
            expected += 1
            var key := "panel" if (c is PanelContainer) else ("background" if c is ProgressBar else "normal")
            var sb := (c as Control).get_theme_stylebox(key)
            if sb is StyleBoxTexture and (sb as StyleBoxTexture).texture != null:
                themed += 1
            elif sb is StyleBoxEmpty and (c is CheckBox or c is CheckButton):
                themed += 1
        _count(c)

func _icon(th: Theme, id: String) -> TextureRect:
    var t := TextureRect.new()
    t.texture = th.get_icon(id, "UiKit")
    t.stretch_mode = TextureRect.STRETCH_KEEP_CENTERED
    t.size_flags_vertical = Control.SIZE_SHRINK_CENTER
    return t

func _build(parent: Node, th: Theme, u: int) -> void:
    var root := VBoxContainer.new()
    root.theme = th
    root.add_theme_constant_override("separation", 4 * u)
    root.position = Vector2(2 * u, 2 * u)
    root.custom_minimum_size = Vector2(256 * u, 0)
    parent.add_child(root)
    # a book kit opens on its spread (the dialogue box ships and is proven; theme.demo.skip may leave it out to fit)
    if th.has_stylebox("panel", "PageLeft"):
        root.add_child(_book(th, u))
    if th.has_stylebox("panel", "PanelContainer"):
        root.add_child(_menu(th, u))
    if th.has_stylebox("panel", "DialogueBox") and false:
        root.add_child(_dialogue(th, u))

func _menu(th: Theme, u: int) -> Control:
    var win := PanelContainer.new()
    var v := VBoxContainer.new()
    v.add_theme_constant_override("separation", 3 * u)
    win.add_child(v)
    var hrow := HBoxContainer.new()
    hrow.add_theme_constant_override("separation", 3 * u)
    v.add_child(hrow)
    if th.has_stylebox("panel", "HeaderPanel"):
        var head := PanelContainer.new()
        head.theme_type_variation = &"HeaderPanel"
        head.size_flags_horizontal = Control.SIZE_EXPAND_FILL
        var hl := Label.new()
        hl.text = "Codex Pages"
        hl.theme_type_variation = &"HeaderLabel"
        head.add_child(hl)
        hrow.add_child(head)
    if th.has_stylebox("normal", "CloseButton"):
        var cb := Button.new()
        cb.theme_type_variation = &"CloseButton"
        cb.custom_minimum_size = Vector2(12 * u, 12 * u)
        cb.size_flags_vertical = Control.SIZE_SHRINK_CENTER
        hrow.add_child(cb)
    var b := HBoxContainer.new()
    b.add_theme_constant_override("separation", 3 * u)
    v.add_child(b)
    for spec in [["Read", &"PrimaryButton", false], ["Journal", &"", false], ["Burn", &"DangerButton", false], ["Sealed", &"", true]]:
        if spec[1] != &"" and not th.has_stylebox("normal", spec[1]):
            continue
        var btn := Button.new()
        btn.text = spec[0]
        btn.theme_type_variation = spec[1]
        btn.disabled = spec[2]
        btn.custom_minimum_size = Vector2(0, 18 * u)
        b.add_child(btn)
    if th.has_icon("checked", "CheckBox"):
        var c := HBoxContainer.new()
        c.add_theme_constant_override("separation", 8 * u)
        v.add_child(c)
        for spec in [["Music", true], ["Ink sounds", false]]:
            var cb2 := CheckBox.new()
            cb2.text = spec[0]
            cb2.button_pressed = spec[1]
            c.add_child(cb2)
        if th.has_icon("checked", "CheckButton"):
            var tg := CheckButton.new()
            tg.text = "Auto turn"
            tg.button_pressed = true
            c.add_child(tg)
    if th.has_stylebox("slider", "HSlider") and false:
        var sr := HBoxContainer.new()
        sr.add_theme_constant_override("separation", 3 * u)
        var sl_l := Label.new()
        sl_l.text = "Volume"
        sl_l.custom_minimum_size = Vector2(36 * u, 0)
        sr.add_child(sl_l)
        var sl := HSlider.new()
        sl.value = 60
        sl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
        sl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
        sl.custom_minimum_size = Vector2(0, 12 * u)
        sr.add_child(sl)
        v.add_child(sr)
    for spec in [[&"HpBar", "HP", 72], [&"MpBar", "MP", 40]]:
        if not th.has_stylebox("fill", spec[0]):
            continue
        var br := HBoxContainer.new()
        br.add_theme_constant_override("separation", 3 * u)
        var bl := Label.new()
        bl.text = spec[1]
        bl.custom_minimum_size = Vector2(36 * u, 0)
        br.add_child(bl)
        var pb := ProgressBar.new()
        pb.theme_type_variation = spec[0]
        pb.value = spec[2]
        pb.show_percentage = false
        pb.size_flags_horizontal = Control.SIZE_EXPAND_FILL
        pb.size_flags_vertical = Control.SIZE_SHRINK_CENTER
        pb.custom_minimum_size = Vector2(0, 8 * u)
        br.add_child(pb)
        var bv := Label.new()
        bv.text = "%d/100" % spec[2]
        bv.custom_minimum_size = Vector2(36 * u, 0)
        bv.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
        br.add_child(bv)
        v.add_child(br)
    # segmented gauges (geometry.segments): rows of fixed-size cells, never a stretched texture; both gauges share ONE
    # row so the dialogue box still fits the 1080 px window (two rows pushed it off the bottom, Night Terminal LOOK 2)
    if th.has_icon("seg_empty", "UiKit"):
        var sg := HBoxContainer.new()
        sg.add_theme_constant_override("separation", 1 * u)
        var first := true
        for gs in [["SHIELD", "seg_mp", 7], ["ENERGY", "seg_stamina", 4]]:
            if not first:
                var sgap := Control.new()
                sgap.custom_minimum_size = Vector2(8 * u, 0)
                sg.add_child(sgap)
            var sgl := Label.new()
            sgl.text = gs[0]
            if first:
                sgl.custom_minimum_size = Vector2(38 * u, 0)
            sg.add_child(sgl)
            if not first:
                var sgap2 := Control.new()
                sgap2.custom_minimum_size = Vector2(2 * u, 0)
                sg.add_child(sgap2)
            first = false
            for i in 10:
                var cell: String = gs[1] if i < int(gs[2]) else "seg_empty"
                if th.has_icon(cell, "UiKit"):
                    sg.add_child(_icon(th, cell))
        v.add_child(sg)
    var fr := HBoxContainer.new()
    fr.add_theme_constant_override("separation", 3 * u)
    if th.has_stylebox("normal", "LineEdit"):
        var le := LineEdit.new()
        le.placeholder_text = "Journal title"
        le.size_flags_horizontal = Control.SIZE_EXPAND_FILL
        fr.add_child(le)
    if th.has_stylebox("normal", "OptionButton"):
        var ob := OptionButton.new()
        for o in ["Chapter I", "Chapter II", "Chapter III"]:
            ob.add_item(o)
        ob.custom_minimum_size = Vector2(76 * u, 0)
        fr.add_child(ob)
    if fr.get_child_count() > 0 and false:
        v.add_child(fr)
    else:
        fr.free()
    if th.has_stylebox("tab_selected", "TabContainer"):
        var tabs := TabContainer.new()
        for t in ["Quests", "Lore", "Map"]:
            var g := GridContainer.new()
            g.name = t
            g.columns = 8
            g.add_theme_constant_override("h_separation", 2 * u)
            g.add_theme_constant_override("v_separation", 2 * u)
            tabs.add_child(g)
        v.add_child(tabs)
        var grid := tabs.get_child(0) as GridContainer
        var icons := ["icon_journal", "icon_tome", "icon_ledger", "wax_seal", "stamp_done", "icon_coin", "heart_full", "icon_star"]
        # equipment slots (geometry.equipment): seven fixed-size cells, one per body part, in the row the inventory slots
        # use (a second row pushed the dialogue box off the 1080 px window); the eighth cell stays an InventorySlot
        var gear := ["equip_head", "equip_body", "equip_hands", "equip_feet", "equip_ring_hover", "equip_weapon_selected", "equip_offhand"]
        for i in 8:
            if i < 7 and th.has_icon(gear[i], "UiKit"):
                grid.add_child(_icon(th, gear[i]))
                continue
            var s := PanelContainer.new()
            s.theme_type_variation = &"InventorySlot"
            s.custom_minimum_size = Vector2(20 * u, 20 * u)
            var ic: String = "icon_star" if th.has_icon("equip_head", "UiKit") else icons[i]
            if ic != "" and th.has_icon(ic, "UiKit"):
                s.add_child(_icon(th, ic))
            grid.add_child(s)
    var hr := HBoxContainer.new()
    hr.add_theme_constant_override("separation", 2 * u)
    for ic in ["heart_full", "heart_full", "heart_full", "heart_half", "heart_empty"]:
        if th.has_icon(ic, "UiKit"):
            hr.add_child(_icon(th, ic))
    if th.has_icon("icon_coin", "UiKit"):
        var gap := Control.new()
        gap.custom_minimum_size = Vector2(6 * u, 0)
        hr.add_child(gap)
        hr.add_child(_icon(th, "icon_coin"))
        var cl := Label.new()
        cl.text = "x 120"
        hr.add_child(cl)
    if th.has_stylebox("normal", "KeyCap"):
        var gap2 := Control.new()
        gap2.custom_minimum_size = Vector2(6 * u, 0)
        hr.add_child(gap2)
        for k in ["E", "Q"]:
            var kc := Button.new()
            kc.text = k
            kc.theme_type_variation = &"KeyCap"
            kc.custom_minimum_size = Vector2(14 * u, 15 * u)
            kc.size_flags_vertical = Control.SIZE_SHRINK_CENTER
            hr.add_child(kc)
    for ic in ["cursor_pointer", "cursor_hand", "cursor_quill"]:
        if th.has_icon(ic, "UiKit"):
            hr.add_child(_icon(th, ic))
    if hr.get_child_count() > 0:
        v.add_child(hr)
    if th.has_stylebox("panel", "TooltipFrame"):
        var tp := PanelContainer.new()
        tp.theme_type_variation = &"TooltipFrame"
        tp.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
        var tl := Label.new()
        tl.text = "Old Key: opens the west vault"
        tl.theme_type_variation = &"TooltipText"
        tp.add_child(tl)
        v.add_child(tp)
    return win

func _dialogue(th: Theme, u: int) -> Control:
    var dlg := PanelContainer.new()
    dlg.theme_type_variation = &"DialogueBox"
    var dv := VBoxContainer.new()
    dv.add_theme_constant_override("separation", 3 * u)
    dlg.add_child(dv)
    if th.has_stylebox("panel", "NamePlate"):
        var np := PanelContainer.new()
        np.theme_type_variation = &"NamePlate"
        np.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
        var nl := Label.new()
        nl.text = "Archivist"
        nl.theme_type_variation = &"NamePlateLabel"
        np.add_child(nl)
        dv.add_child(np)
    var dl := Label.new()
    dl.text = "Every page here was copied by hand.\nTurn carefully, the binding is old."
    dl.theme_type_variation = &"DialogueLabel"
    dv.add_child(dl)
    if th.has_icon("advance_arrow_frame0", "UiKit"):
        var ar := _icon(th, "advance_arrow_frame0")
        ar.size_flags_horizontal = Control.SIZE_SHRINK_END
        dv.add_child(ar)
    return dlg

func _book(th: Theme, u: int) -> Control:
    var box := Control.new()
    box.custom_minimum_size = Vector2(254 * u, 140 * u)
    # the spread is 220 units wide; each tab is 40 wide from x 216, so 36 units stand out past the fore-edge and the label
    # sits right-aligned in that visible part (at x 225 / 29 wide only an 8-unit sliver showed, LOOK 1 2026-10-24). Sizes are
    # set DEFERRED: a size set before the theme reaches the Button is clamped to Godot's DEFAULT font and never shrinks (the
    # pixel tabs came out 15 units tall and ran off the viewport, LOOK 2 2026-10-24)
    var ty := 16
    for spec in [[&"EdgeTabRed", "Map", false], [&"EdgeTabBlue", "Lore", true], [&"EdgeTabGreen", "Gear", false]]:
        if th.has_stylebox("normal", spec[0]):
            var tb := Button.new()
            tb.theme_type_variation = spec[0]
            tb.text = spec[1]
            tb.alignment = HORIZONTAL_ALIGNMENT_RIGHT
            tb.toggle_mode = true
            tb.button_pressed = spec[2]
            tb.focus_mode = Control.FOCUS_NONE
            tb.position = Vector2(216 * u, ty * u)
            tb.set_deferred("size", Vector2(40 * u, 12 * u))
            box.add_child(tb)
        ty += 15
    # ribbons hang 24 units under the bottom edge (they read as specks at 8, LOOK 1 2026-10-24)
    for spec in [[&"BookmarkRed", 96, false], [&"BookmarkGold", 105, true], [&"BookmarkBlue", 134, false]]:
        if th.has_stylebox("normal", spec[0]):
            var bm := Button.new()
            bm.theme_type_variation = spec[0]
            bm.toggle_mode = true
            bm.button_pressed = spec[2]
            bm.focus_mode = Control.FOCUS_NONE
            bm.position = Vector2(spec[1] * u, 100 * u)
            bm.set_deferred("size", Vector2(9 * u, 36 * u))
            box.add_child(bm)
    var spread := HBoxContainer.new()
    spread.add_theme_constant_override("separation", 0)
    box.add_child(spread)
    var left := PanelContainer.new()
    left.theme_type_variation = &"PageLeft"
    left.custom_minimum_size = Vector2(110 * u, 112 * u)
    spread.add_child(left)
    var lv := VBoxContainer.new()
    lv.add_theme_constant_override("separation", 1 * u)
    left.add_child(lv)
    if th.has_stylebox("panel", "ChapterHeading"):
        var hd := PanelContainer.new()
        hd.theme_type_variation = &"ChapterHeading"
        var hl := Label.new()
        hl.text = "Quest Log"
        hl.theme_type_variation = &"ChapterLabel"
        hl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
        hd.add_child(hl)
        lv.add_child(hd)
    for spec in [["Sealed Gate", "", "stamp_active"], ["The Ferry", "selected", "stamp_new"], ["Morrow Bells", "disabled", "stamp_done"], ["Lost Choir", "", "stamp_failed"]]:
        if not th.has_stylebox("normal", "QuestEntry"):
            break
        var qr := HBoxContainer.new()
        qr.add_theme_constant_override("separation", 2 * u)
        var qe := Button.new()
        qe.theme_type_variation = &"QuestEntry"
        qe.text = spec[0]
        qe.alignment = HORIZONTAL_ALIGNMENT_LEFT
        qe.toggle_mode = true
        qe.button_pressed = spec[1] == "selected"
        qe.disabled = spec[1] == "disabled"
        qe.focus_mode = Control.FOCUS_NONE
        qe.custom_minimum_size = Vector2(0, 14 * u)
        qe.size_flags_horizontal = Control.SIZE_EXPAND_FILL
        qr.add_child(qe)
        if th.has_icon(spec[2], "UiKit"):
            qr.add_child(_icon(th, spec[2]))
        lv.add_child(qr)
    _page_number(th, lv, "12", u)
    var right := PanelContainer.new()
    right.theme_type_variation = &"PageRight"
    right.custom_minimum_size = Vector2(110 * u, 112 * u)
    spread.add_child(right)
    var rv := VBoxContainer.new()
    rv.add_theme_constant_override("separation", 2 * u)
    right.add_child(rv)
    # the paragraph: two lines beside the 2-line initial, then the rest at the full page width (v0 kept line 3 indented
    # beside empty paper, LOOK 1 2026-10-24)
    var para := VBoxContainer.new()
    para.add_theme_constant_override("separation", 0)
    rv.add_child(para)
    var top := HBoxContainer.new()
    top.add_theme_constant_override("separation", 3 * u)
    para.add_child(top)
    if th.has_stylebox("panel", "DropCap"):
        # the initial at twice the kit face: a 2x Label inside a fixed box (the theme font is a fixed-size pixel face)
        var dc := PanelContainer.new()
        dc.theme_type_variation = &"DropCap"
        dc.custom_minimum_size = Vector2(22 * u, 22 * u)
        dc.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
        var holder := Control.new()
        holder.custom_minimum_size = Vector2(8 * u, 8 * u)
        dc.add_child(holder)
        var dl := Label.new()
        dl.text = "E"
        dl.theme_type_variation = &"DropCapLabel"
        dl.scale = Vector2(2, 2)
        dl.position = Vector2(-1 * u, -5 * u)
        holder.add_child(dl)
        top.add_child(dc)
    var n1 := Label.new()
    n1.text = "very page\nwas copied"
    n1.theme_type_variation = &"PageLabel"
    top.add_child(n1)
    if "by hand, in ink." != "":
        var n3 := Label.new()
        n3.text = "by hand, in ink."
        n3.theme_type_variation = &"PageLabel"
        para.add_child(n3)
    if th.has_stylebox("panel", "FlourishDivider"):
        var fd := PanelContainer.new()
        fd.theme_type_variation = &"FlourishDivider"
        fd.custom_minimum_size = Vector2(0, 7 * u)
        rv.add_child(fd)
    var n2 := Label.new()
    n2.text = "Ask the ferryman\nabout the bells."
    n2.theme_type_variation = &"PageLabel"
    rv.add_child(n2)
    if th.has_icon("wax_seal", "UiKit"):
        var sr := HBoxContainer.new()
        sr.add_theme_constant_override("separation", 3 * u)
        sr.add_child(_icon(th, "wax_seal"))
        var sl := Label.new()
        sl.text = "By the Keep"
        sl.theme_type_variation = &"PageLabel"
        sl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
        sr.add_child(sl)
        rv.add_child(sr)
    _page_number(th, rv, "13", u)
    return box

# a page number cartouche at the foot of a page column (an expanding spacer pushes it down)
func _page_number(th: Theme, col: Control, text: String, u: int) -> void:
    if not th.has_stylebox("panel", "PageNumber"):
        return
    var sp := Control.new()
    sp.size_flags_vertical = Control.SIZE_EXPAND_FILL
    col.add_child(sp)
    var pn := PanelContainer.new()
    pn.theme_type_variation = &"PageNumber"
    pn.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
    var pl := Label.new()
    pl.text = text
    pl.theme_type_variation = &"PageNumberLabel"
    pl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    pn.add_child(pl)
    col.add_child(pn)
