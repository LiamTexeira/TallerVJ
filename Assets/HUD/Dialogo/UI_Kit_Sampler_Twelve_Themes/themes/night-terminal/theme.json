{
  "schema": "csaf-uikit-theme/1",
  "id": "night-terminal",
  "name": "Night Terminal",
  "note": "Kit 5 (2026-10-17): a dark sci-fi HUD theme. Cyan steel frames with 45-degree chamfered corners (geometry.cut) over deep navy panels, amber HUD corner ticks flanking every chamfer on the heavy frames (geometry.corner \"bracket\"), an amber accent family with dark ink for the main actions, a red danger family, and fixed-size segment cells for segmented shield and energy gauges (geometry.segments). For shooters, hacking and space games. Every text-on-fill pair is re-measured by the gate.",
  "geometry": {
    "border": 3,
    "radius": 4,
    "shadow": 1,
    "hdScale": 3,
    "style": "bevel",
    "ornaments": true,
    "corner": "bracket",
    "cut": true,
    "segments": true
  },
