extends Control
## CSAF UI Kit Sampler: all twelve themes on one screen. Each cell renders one theme's PIXEL theme at 1x in a SubViewport,
## scaled 2x nearest-neighbour: a window with the theme's name, its button in all four states (normal, hover, pressed,
## disabled: hover and pressed are the theme's own hover and pressed styleboxes shown as the normal one, so you can see
## them without a mouse), an HP bar, its icons and cursors, and the dialogue box with its name plate and advance arrow.
## Generated by CSAF build.js from each theme's shipped files.
##   run:        godot --path <this folder>
##   screenshot: godot --path <this folder> -- --shot=<absolute png path>
## Copyright (c) 2026 Core Systems Asset Factory.

const KITS := [
	{"id": "bone-and-brass", "name": "Bone and Brass", "bg": "#3a3532", "buttons": ["Descend", "Hover", "Press", "Sealed"], "speaker": "The Warden", "line": "The crypt gate is shut. Bring me the\niron key."},
	{"id": "casual-pop", "name": "Casual Pop", "bg": "#7cc8f8", "buttons": ["Play", "Hover", "Pressed", "Locked"], "speaker": "Pip", "line": "Pop four bubbles of one colour to clear\nthem!"},
	{"id": "clean-slate", "name": "Clean Slate", "bg": "#dde2e9", "buttons": ["Play", "Hover", "Pressed", "Locked"], "speaker": "Guide", "line": "Match three tiles of one colour to clear\nthem."},
	{"id": "codex-pages", "name": "Codex Pages", "bg": "#1f2b28", "buttons": ["Read", "Hover", "Pressed", "Sealed"], "speaker": "Archivist", "line": "Every page here was copied by hand."},
	{"id": "ember-court", "name": "Ember Court", "bg": "#465468", "buttons": ["New Game", "Hover", "Press", "Locked"], "speaker": "Captain Vey", "line": "The north gate is sealed by royal\norder."},
	{"id": "felt-table", "name": "Felt Table", "bg": "#211715", "buttons": ["Play", "Hover", "Pressed", "Locked"], "speaker": "Dealer", "line": "The house deals first tonight."},
	{"id": "four-shade", "name": "Four Shade", "bg": "#466140", "buttons": ["Start", "Hover", "Pressed", "Locked"], "speaker": "Keeper", "line": "Four shades are all this world has."},
	{"id": "hearthwood", "name": "Hearthwood", "bg": "#7c9a55", "buttons": ["Plant", "Hover", "Pressed", "Locked"], "speaker": "Neighbour Wren", "line": "The rain came early this year."},
	{"id": "iron-bastion", "name": "Iron Bastion", "bg": "#34402a", "buttons": ["Build", "Hover", "Pressed", "Locked"], "speaker": "Castellan", "line": "The east wall is finished, and the moat\nis full."},
	{"id": "night-terminal", "name": "Night Terminal", "bg": "#1b2c3e", "buttons": ["Engage", "Hover", "Pressed", "Locked"], "speaker": "Relay AI", "line": "Hull breach sealed. Oxygen at 64%."},
	{"id": "silverpoint", "name": "Silverpoint", "bg": "#34302a", "buttons": ["Begin", "Hover", "Pressed", "Sealed"], "speaker": "Archivist", "line": "The old road north is marked on this\nmap."},
	{"id": "verdant-frame", "name": "Verdant Frame", "bg": "#4f8a3c", "buttons": ["Camp", "Hover", "Pressed", "Locked"], "speaker": "Old Miller", "line": "The river rose and took the ford."},
]
const COLS := 4
const CELL := Vector2(464, 344)
const SHRINK := 2
const GAP := 16
const PAD := 8
const ROOT_X := 4
const ROOT_W := 224
const COMMON_ICONS := ["heart_full", "heart_empty", "cursor_pointer", "cursor_select", "advance_arrow_frame0", "advance_arrow_frame1"]
var themed := 0
var expected := 0
var arrows: Array = []
var roots: Array = []

func _ready() -> void:
    var bg := ColorRect.new()
    bg.color = Color("#0d0f13")
    bg.set_anchors_preset(Control.PRESET_FULL_RECT)
    add_child(bg)
    var grid := GridContainer.new()
    grid.columns = COLS
    grid.position = Vector2(PAD, PAD)
    grid.add_theme_constant_override("h_separation", GAP)
    grid.add_theme_constant_override("v_separation", GAP)
    add_child(grid)
    for k in KITS:
        var svc := SubViewportContainer.new()
        svc.stretch = true
        svc.stretch_shrink = SHRINK
        svc.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
        svc.custom_minimum_size = CELL
        grid.add_child(svc)
        var sv := SubViewport.new()
        sv.canvas_item_default_texture_filter = Viewport.DEFAULT_CANVAS_ITEM_TEXTURE_FILTER_NEAREST
        svc.add_child(sv)
        _cell(sv, k)
    var t := Timer.new()
    t.wait_time = 0.5
    t.autostart = true
    t.timeout.connect(_blink)
    add_child(t)
    var shot := ""
    for a in OS.get_cmdline_user_args():
        if a.begins_with("--shot="):
            shot = a.substr(7)
    if shot != "":
        await get_tree().process_frame
        await get_tree().process_frame
        await get_tree().process_frame
        await RenderingServer.frame_post_draw
        _count(self)
        _fit()
        var img := get_viewport().get_texture().get_image()
        var err := img.save_png(shot)
        print("UIKIT_THEMED|%d|%d" % [themed, expected])
        print("UIKIT_SHOT|%s|%d|%d|%s" % ["ok" if err == OK else "error %d" % err, img.get_width(), img.get_height(), shot])
        get_tree().quit(0 if err == OK else 3)

## every themed control must resolve to the kit's texture (a load is not a verdict)
func _count(n: Node) -> void:
    for c in n.get_children():
        if c is Button or c is PanelContainer or c is ProgressBar:
            expected += 1
            var key := "panel" if (c is PanelContainer) else ("background" if c is ProgressBar else "normal")
            var sb := (c as Control).get_theme_stylebox(key)
            if sb is StyleBoxTexture and (sb as StyleBoxTexture).texture != null:
                themed += 1
            else:
                print("UIKIT_UNTHEMED|%s" % c.get_path())
        _count(c)

## every cell's content must fit inside its 1x viewport (a cell that overflows is cut off in the buyer's view)
func _fit() -> void:
    for r in roots:
        var root: Control = r[1]
        var vp: Vector2 = Vector2((r[0] as SubViewport).size)
        var end := root.position + root.size
        print("UIKIT_FIT|%s|%s|%d|%d|%d|%d" % [r[2], "ok" if (end.x <= vp.x and end.y <= vp.y) else "over", int(end.x), int(end.y), int(vp.x), int(vp.y)])

func _blink() -> void:
    for a in arrows:
        var tr: TextureRect = a[0]
        var th: Theme = a[1]
        var f := "advance_arrow_frame1" if tr.get_meta("frame", 0) == 0 else "advance_arrow_frame0"
        tr.set_meta("frame", 1 if f == "advance_arrow_frame1" else 0)
        tr.texture = th.get_icon(f, "UiKit")

func _icon(th: Theme, id: String) -> TextureRect:
    var t := TextureRect.new()
    t.texture = th.get_icon(id, "UiKit")
    t.stretch_mode = TextureRect.STRETCH_KEEP_CENTERED
    t.size_flags_vertical = Control.SIZE_SHRINK_CENTER
    return t

func _cell(sv: SubViewport, k: Dictionary) -> void:
    var th: Theme = load("res://uikit/%s/pixel/theme_pixel.tres" % k["id"])
    var back := ColorRect.new()
    back.color = Color(k["bg"])
    back.set_anchors_preset(Control.PRESET_FULL_RECT)
    sv.add_child(back)
    var root := VBoxContainer.new()
    root.theme = th
    root.position = Vector2(ROOT_X, ROOT_X)
    root.custom_minimum_size = Vector2(ROOT_W, 0)
    root.add_theme_constant_override("separation", 4)
    sv.add_child(root)
    roots.append([sv, root, k["id"]])
    # the window: name, the four button states, the HP bar, the icons
    var win := PanelContainer.new()
    root.add_child(win)
    var v := VBoxContainer.new()
    v.add_theme_constant_override("separation", 3)
    win.add_child(v)
    if th.has_stylebox("panel", "HeaderPanel"):
        var head := PanelContainer.new()
        head.theme_type_variation = &"HeaderPanel"
        var hl := Label.new()
        hl.text = k["name"]
        hl.theme_type_variation = &"HeaderLabel"
        head.add_child(hl)
        v.add_child(head)
    else:
        var nl := Label.new()
        nl.text = k["name"]
        v.add_child(nl)
    var b := HBoxContainer.new()
    b.add_theme_constant_override("separation", 3)
    v.add_child(b)
    var btns: Array = k["buttons"]
    for i in 4:
        var btn := Button.new()
        btn.text = btns[i]
        btn.focus_mode = Control.FOCUS_NONE
        btn.custom_minimum_size = Vector2(0, 16)
        if i == 1:
            btn.add_theme_stylebox_override("normal", th.get_stylebox("hover", "Button"))
            btn.add_theme_color_override("font_color", th.get_color("font_hover_color", "Button"))
        elif i == 2:
            btn.add_theme_stylebox_override("normal", th.get_stylebox("pressed", "Button"))
            btn.add_theme_color_override("font_color", th.get_color("font_pressed_color", "Button"))
        elif i == 3:
            btn.disabled = true
        b.add_child(btn)
    var br := HBoxContainer.new()
    br.add_theme_constant_override("separation", 3)
    var bl := Label.new()
    bl.text = "HP"
    br.add_child(bl)
    var pb := ProgressBar.new()
    pb.theme_type_variation = &"HpBar"
    pb.value = 72
    pb.show_percentage = false
    pb.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    pb.size_flags_vertical = Control.SIZE_SHRINK_CENTER
    pb.custom_minimum_size = Vector2(0, 8)
    br.add_child(pb)
    var bv := Label.new()
    bv.text = "72/100"
    br.add_child(bv)
    v.add_child(br)
    var ir := HBoxContainer.new()
    ir.add_theme_constant_override("separation", 3)
    for ic in ["heart_full", "heart_full", "heart_full"]:
        ir.add_child(_icon(th, ic))
    if th.has_icon("heart_empty", "UiKit"):
        ir.add_child(_icon(th, "heart_empty"))
    var gap := Control.new()
    gap.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    ir.add_child(gap)
    # the theme's own extra sampler icons (coin, seals, gems, gauges, equipment...), then the two cursors
    for ic in th.get_icon_list("UiKit"):
        if not COMMON_ICONS.has(ic):
            ir.add_child(_icon(th, ic))
    for ic in ["cursor_pointer", "cursor_select"]:
        ir.add_child(_icon(th, ic))
    v.add_child(ir)
    # the dialogue box: name plate, the line, the advance arrow (it blinks between its two frames)
    var dlg := PanelContainer.new()
    dlg.theme_type_variation = &"DialogueBox"
    root.add_child(dlg)
    var dv := VBoxContainer.new()
    dv.add_theme_constant_override("separation", 2)
    dlg.add_child(dv)
    var np := PanelContainer.new()
    np.theme_type_variation = &"NamePlate"
    np.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
    var npl := Label.new()
    npl.text = k["speaker"]
    npl.theme_type_variation = &"NamePlateLabel"
    np.add_child(npl)
    dv.add_child(np)
    var dl := Label.new()
    dl.text = k["line"]
    dl.theme_type_variation = &"DialogueLabel"
    dv.add_child(dl)
    var ar := _icon(th, "advance_arrow_frame0")
    ar.size_flags_horizontal = Control.SIZE_SHRINK_END
    ar.set_meta("frame", 0)
    dv.add_child(ar)
    arrows.append([ar, th])
