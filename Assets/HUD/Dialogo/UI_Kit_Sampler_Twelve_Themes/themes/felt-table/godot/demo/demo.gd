extends Control
## Felt Table UI Kit demo: builds the kit's controls with the PIXEL theme (rendered at 1x in a SubViewport and scaled 3x
## nearest-neighbour) and, when present, again with the HD theme at 1x. Every block checks the theme has the types it
## uses, so the same script runs the full kit and the free sampler. Generated by CSAF uikit_gen.js.
##   run:        godot --path <this folder>
##   screenshot: godot --path <this folder> -- --shot=<absolute png path>
## Copyright (c) 2026 Core Systems Asset Factory.

const PIXEL_THEME := "res://uikit/felt-table/pixel/theme_pixel.tres"
const HD_THEME := "res://uikit/felt-table/hd/theme_hd.tres"
var themed := 0
var expected := 0

func _ready() -> void:
    var bg := ColorRect.new()
    bg.color = Color("#211715")
    bg.set_anchors_preset(Control.PRESET_FULL_RECT)
    add_child(bg)
    var row := HBoxContainer.new()
    row.position = Vector2(16, 16)
    row.add_theme_constant_override("separation", 24)
    add_child(row)
    var svc := SubViewportContainer.new()
    svc.stretch = true
    svc.stretch_shrink = 3
    svc.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    svc.custom_minimum_size = Vector2(800, 1050)
    row.add_child(svc)
    var sv := SubViewport.new()
    sv.transparent_bg = true
    sv.canvas_item_default_texture_filter = Viewport.DEFAULT_CANVAS_ITEM_TEXTURE_FILTER_NEAREST
    svc.add_child(sv)
    _build(sv, load(PIXEL_THEME), 1)
    if ResourceLoader.exists(HD_THEME):
        var hd := Control.new()
        hd.custom_minimum_size = Vector2(800, 1050)
        row.add_child(hd)
        _build(hd, load(HD_THEME), 3)
    var shot := ""
    for a in OS.get_cmdline_user_args():
        if a.begins_with("--shot="):
            shot = a.substr(7)
    if shot != "":
        await get_tree().process_frame
        await get_tree().process_frame
        await get_tree().process_frame
        await RenderingServer.frame_post_draw
        _count(self)
        var img := get_viewport().get_texture().get_image()
        var err := img.save_png(shot)
        print("UIKIT_THEMED|%d|%d" % [themed, expected])
        print("UIKIT_SHOT|%s|%d|%d|%s" % ["ok" if err == OK else "error %d" % err, img.get_width(), img.get_height(), shot])
        get_tree().quit(0 if err == OK else 3)

func _count(n: Node) -> void:
    for c in n.get_children():
        if c is Button or c is PanelContainer or c is LineEdit or c is ProgressBar:
            expected += 1
            var key := "panel" if (c is PanelContainer) else ("background" if c is ProgressBar else "normal")
            var sb := (c as Control).get_theme_stylebox(key)
            if sb is StyleBoxTexture and (sb as StyleBoxTexture).texture != null:
                themed += 1
            elif sb is StyleBoxEmpty and (c is CheckBox or c is CheckButton):
                themed += 1
        _count(c)

func _icon(th: Theme, id: String) -> TextureRect:
    var t := TextureRect.new()
    t.texture = th.get_icon(id, "UiKit")
    t.stretch_mode = TextureRect.STRETCH_KEEP_CENTERED
    t.size_flags_vertical = Control.SIZE_SHRINK_CENTER
    return t

func _build(parent: Node, th: Theme, u: int) -> void:
    var root := VBoxContainer.new()
    root.theme = th
    root.add_theme_constant_override("separation", 4 * u)
    root.position = Vector2(2 * u, 2 * u)
    root.custom_minimum_size = Vector2(256 * u, 0)
    parent.add_child(root)
    # a card kit shows its table first; its dialogue box ships and is proven, but the table takes its place in the demo
    if th.has_stylebox("normal", "CardAttack"):
        root.add_child(_table(th, u))
    if th.has_stylebox("panel", "PanelContainer"):
        root.add_child(_menu(th, u))
    if th.has_stylebox("panel", "DialogueBox") and not th.has_stylebox("normal", "CardAttack"):
        root.add_child(_dialogue(th, u))

func _menu(th: Theme, u: int) -> Control:
    var win := PanelContainer.new()
    var v := VBoxContainer.new()
    v.add_theme_constant_override("separation", 3 * u)
    win.add_child(v)
    var hrow := HBoxContainer.new()
    hrow.add_theme_constant_override("separation", 3 * u)
    v.add_child(hrow)
    if th.has_stylebox("panel", "HeaderPanel"):
        var head := PanelContainer.new()
        head.theme_type_variation = &"HeaderPanel"
        head.size_flags_horizontal = Control.SIZE_EXPAND_FILL
        var hl := Label.new()
        hl.text = "Felt Table"
        hl.theme_type_variation = &"HeaderLabel"
        head.add_child(hl)
        hrow.add_child(head)
    if th.has_stylebox("normal", "CloseButton"):
        var cb := Button.new()
        cb.theme_type_variation = &"CloseButton"
        cb.custom_minimum_size = Vector2(12 * u, 12 * u)
        cb.size_flags_vertical = Control.SIZE_SHRINK_CENTER
        hrow.add_child(cb)
    var b := HBoxContainer.new()
    b.add_theme_constant_override("separation", 3 * u)
    v.add_child(b)
    for spec in [["Play", &"PrimaryButton", false], ["Deck", &"", false], ["Forfeit", &"DangerButton", false], ["Locked", &"", true]]:
        if spec[1] != &"" and not th.has_stylebox("normal", spec[1]):
            continue
        var btn := Button.new()
        btn.text = spec[0]
        btn.theme_type_variation = spec[1]
        btn.disabled = spec[2]
        btn.custom_minimum_size = Vector2(0, 18 * u)
        b.add_child(btn)
    if th.has_icon("checked", "CheckBox"):
        var c := HBoxContainer.new()
        c.add_theme_constant_override("separation", 8 * u)
        v.add_child(c)
        for spec in [["Music", true], ["Fast mode", false]]:
            var cb2 := CheckBox.new()
            cb2.text = spec[0]
            cb2.button_pressed = spec[1]
            c.add_child(cb2)
        if th.has_icon("checked", "CheckButton"):
            var tg := CheckButton.new()
            tg.text = "Auto end"
            tg.button_pressed = true
            c.add_child(tg)
    if th.has_stylebox("slider", "HSlider") and false:
        var sr := HBoxContainer.new()
        sr.add_theme_constant_override("separation", 3 * u)
        var sl_l := Label.new()
        sl_l.text = "Volume"
        sl_l.custom_minimum_size = Vector2(36 * u, 0)
        sr.add_child(sl_l)
        var sl := HSlider.new()
        sl.value = 60
        sl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
        sl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
        sl.custom_minimum_size = Vector2(0, 12 * u)
        sr.add_child(sl)
        v.add_child(sr)
    for spec in [[&"HpBar", "HP", 72]]:
        if not th.has_stylebox("fill", spec[0]):
            continue
        var br := HBoxContainer.new()
        br.add_theme_constant_override("separation", 3 * u)
        var bl := Label.new()
        bl.text = spec[1]
        bl.custom_minimum_size = Vector2(36 * u, 0)
        br.add_child(bl)
        var pb := ProgressBar.new()
        pb.theme_type_variation = spec[0]
        pb.value = spec[2]
        pb.show_percentage = false
        pb.size_flags_horizontal = Control.SIZE_EXPAND_FILL
        pb.size_flags_vertical = Control.SIZE_SHRINK_CENTER
        pb.custom_minimum_size = Vector2(0, 8 * u)
        br.add_child(pb)
        var bv := Label.new()
        bv.text = "%d/100" % spec[2]
        bv.custom_minimum_size = Vector2(36 * u, 0)
        bv.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
        br.add_child(bv)
        v.add_child(br)
    # segmented gauges (geometry.segments): rows of fixed-size cells, never a stretched texture; both gauges share ONE
    # row so the dialogue box still fits the 1080 px window (two rows pushed it off the bottom, Night Terminal LOOK 2)
    if th.has_icon("seg_empty", "UiKit"):
        var sg := HBoxContainer.new()
        sg.add_theme_constant_override("separation", 1 * u)
        var first := true
        for gs in [["SHIELD", "seg_mp", 7], ["ENERGY", "seg_stamina", 4]]:
            if not first:
                var sgap := Control.new()
                sgap.custom_minimum_size = Vector2(8 * u, 0)
                sg.add_child(sgap)
            var sgl := Label.new()
            sgl.text = gs[0]
            if first:
                sgl.custom_minimum_size = Vector2(38 * u, 0)
            sg.add_child(sgl)
            if not first:
                var sgap2 := Control.new()
                sgap2.custom_minimum_size = Vector2(2 * u, 0)
                sg.add_child(sgap2)
            first = false
            for i in 10:
                var cell: String = gs[1] if i < int(gs[2]) else "seg_empty"
                if th.has_icon(cell, "UiKit"):
                    sg.add_child(_icon(th, cell))
        v.add_child(sg)
    var fr := HBoxContainer.new()
    fr.add_theme_constant_override("separation", 3 * u)
    if th.has_stylebox("normal", "LineEdit"):
        var le := LineEdit.new()
        le.placeholder_text = "Deck name"
        le.size_flags_horizontal = Control.SIZE_EXPAND_FILL
        fr.add_child(le)
    if th.has_stylebox("normal", "OptionButton"):
        var ob := OptionButton.new()
        for o in ["Standard", "Draft", "Endless"]:
            ob.add_item(o)
        ob.custom_minimum_size = Vector2(76 * u, 0)
        fr.add_child(ob)
    if fr.get_child_count() > 0 and false:
        v.add_child(fr)
    else:
        fr.free()
    if th.has_stylebox("tab_selected", "TabContainer"):
        var tabs := TabContainer.new()
        for t in ["Relics", "Deck", "Map"]:
            var g := GridContainer.new()
            g.name = t
            g.columns = 8
            g.add_theme_constant_override("h_separation", 2 * u)
            g.add_theme_constant_override("v_separation", 2 * u)
            tabs.add_child(g)
        v.add_child(tabs)
        var grid := tabs.get_child(0) as GridContainer
        var icons := ["rarity_common", "rarity_uncommon", "rarity_rare", "rarity_legendary", "block_badge", "icon_coin", "energy_spent", "intent_unknown"]
        # equipment slots (geometry.equipment): seven fixed-size cells, one per body part, in the row the inventory slots
        # use (a second row pushed the dialogue box off the 1080 px window); the eighth cell stays an InventorySlot
        var gear := ["equip_head", "equip_body", "equip_hands", "equip_feet", "equip_ring_hover", "equip_weapon_selected", "equip_offhand"]
        for i in 8:
            if i < 7 and th.has_icon(gear[i], "UiKit"):
                grid.add_child(_icon(th, gear[i]))
                continue
            var s := PanelContainer.new()
            s.theme_type_variation = &"InventorySlot"
            s.custom_minimum_size = Vector2(20 * u, 20 * u)
            var ic: String = "icon_star" if th.has_icon("equip_head", "UiKit") else icons[i]
            if ic != "" and th.has_icon(ic, "UiKit"):
                s.add_child(_icon(th, ic))
            grid.add_child(s)
    var hr := HBoxContainer.new()
    hr.add_theme_constant_override("separation", 2 * u)
    for ic in ["heart_full", "heart_full", "heart_full", "heart_half", "heart_empty"]:
        if th.has_icon(ic, "UiKit"):
            hr.add_child(_icon(th, ic))
    if th.has_icon("icon_coin", "UiKit"):
        var gap := Control.new()
        gap.custom_minimum_size = Vector2(6 * u, 0)
        hr.add_child(gap)
        hr.add_child(_icon(th, "icon_coin"))
        var cl := Label.new()
        cl.text = "x 120"
        hr.add_child(cl)
    if th.has_stylebox("normal", "KeyCap"):
        var gap2 := Control.new()
        gap2.custom_minimum_size = Vector2(6 * u, 0)
        hr.add_child(gap2)
        for k in ["E", "Q"]:
            var kc := Button.new()
            kc.text = k
            kc.theme_type_variation = &"KeyCap"
            kc.custom_minimum_size = Vector2(14 * u, 15 * u)
            kc.size_flags_vertical = Control.SIZE_SHRINK_CENTER
            hr.add_child(kc)
    for ic in ["cursor_pointer", "cursor_hand"]:
        if th.has_icon(ic, "UiKit"):
            hr.add_child(_icon(th, ic))
    if hr.get_child_count() > 0:
        v.add_child(hr)
    if th.has_stylebox("panel", "TooltipFrame"):
        var tp := PanelContainer.new()
        tp.theme_type_variation = &"TooltipFrame"
        tp.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
        var tl := Label.new()
        tl.text = "Exhaust: gone until the fight ends"
        tl.theme_type_variation = &"TooltipText"
        tp.add_child(tl)
        v.add_child(tp)
    return win

func _dialogue(th: Theme, u: int) -> Control:
    var dlg := PanelContainer.new()
    dlg.theme_type_variation = &"DialogueBox"
    var dv := VBoxContainer.new()
    dv.add_theme_constant_override("separation", 3 * u)
    dlg.add_child(dv)
    if th.has_stylebox("panel", "NamePlate"):
        var np := PanelContainer.new()
        np.theme_type_variation = &"NamePlate"
        np.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
        var nl := Label.new()
        nl.text = "Dealer"
        nl.theme_type_variation = &"NamePlateLabel"
        np.add_child(nl)
        dv.add_child(np)
    var dl := Label.new()
    dl.text = "The house deals first tonight.\nDraw five and play what you can."
    dl.theme_type_variation = &"DialogueLabel"
    dv.add_child(dl)
    if th.has_icon("advance_arrow_frame0", "UiKit"):
        var ar := _icon(th, "advance_arrow_frame0")
        ar.size_flags_horizontal = Control.SIZE_SHRINK_END
        dv.add_child(ar)
    return dlg

func _table(th: Theme, u: int) -> Control:
    var tb := PanelContainer.new()
    var v := VBoxContainer.new()
    v.add_theme_constant_override("separation", 2 * u)
    tb.add_child(v)
    var top := HBoxContainer.new()
    top.add_theme_constant_override("separation", 3 * u)
    v.add_child(top)
    if th.has_stylebox("panel", "TurnBanner"):
        var bn := PanelContainer.new()
        bn.theme_type_variation = &"TurnBanner"
        bn.size_flags_vertical = Control.SIZE_SHRINK_CENTER
        var bl := Label.new()
        bl.text = "YOUR TURN"
        bl.theme_type_variation = &"TurnBannerLabel"
        bn.add_child(bl)
        top.add_child(bn)
    var sp := Control.new()
    sp.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    top.add_child(sp)
    for ic in ["intent_attack", "intent_defend", "intent_buff", "intent_unknown"]:
        if th.has_icon(ic, "UiKit"):
            top.add_child(_icon(th, ic))
    var hand := HBoxContainer.new()
    hand.add_theme_constant_override("separation", 1 * u)
    hand.alignment = BoxContainer.ALIGNMENT_CENTER
    v.add_child(hand)
    for spec in [[&"CardAttack", "Slash", "1", "Deal 6\ndamage", "", "intent_attack"], [&"CardSkill", "Guard", "1", "Gain 5\nBlock", "", "intent_defend"], [&"CardPower", "Focus", "2", "Draw 1\nmore", "selected", "intent_buff"], [&"CardCurse", "Doubt", "0", "Cannot\nplay", "disabled", "intent_unknown"]]:
        if not th.has_stylebox("normal", spec[0]):
            continue
        var card := Button.new()
        card.theme_type_variation = spec[0]
        card.custom_minimum_size = Vector2(52 * u, 74 * u)
        card.toggle_mode = true
        card.button_pressed = spec[4] == "selected"
        card.disabled = spec[4] == "disabled"
        card.focus_mode = Control.FOCUS_NONE
        hand.add_child(card)
        _card_text(th, card, spec, u)
    var bot := HBoxContainer.new()
    bot.add_theme_constant_override("separation", 2 * u)
    v.add_child(bot)
    _pile(th, bot, "pile_draw", "12", u)
    for ic in ["energy_full", "energy_full", "energy_spent"]:
        if th.has_icon(ic, "UiKit"):
            bot.add_child(_icon(th, ic))
    # the player's block: the shield with its number, on the player's side of the table (LOOK 2: at the end of the enemy's
    # intent row it read as a fifth intent)
    var gap := Control.new()
    gap.custom_minimum_size = Vector2(4 * u, 0)
    bot.add_child(gap)
    _numbered(th, bot, "block_badge", "5", u)
    var sp2 := Control.new()
    sp2.custom_minimum_size = Vector2(6 * u, 0)
    sp2.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    bot.add_child(sp2)
    _pile(th, bot, "pile_discard", "4", u)
    _pile(th, bot, "pile_exhaust", "1", u)
    if th.has_stylebox("normal", "EndTurnButton"):
        var et := Button.new()
        et.text = "End Turn"
        et.theme_type_variation = &"EndTurnButton"
        et.size_flags_vertical = Control.SIZE_SHRINK_CENTER
        et.focus_mode = Control.FOCUS_NONE
        bot.add_child(et)
    return tb

# the buyer's text on a card: the cost on the gem, the name on the name plate, the rules in the rules box (unit positions
# read off the card frame's geometry: gem 0..10, name plate fill rows 6..15 from x 12, art window fill rows 19..41 x 6..44,
# rules box fill rows 45..66 x 6..44)
func _card_text(th: Theme, card: Button, spec: Array, u: int) -> void:
    if spec.size() > 5 and th.has_icon(spec[5], "UiKit"):
        var art := TextureRect.new()
        art.texture = th.get_icon(spec[5], "UiKit")
        art.stretch_mode = TextureRect.STRETCH_KEEP_CENTERED
        art.position = Vector2(6 * u, 19 * u)
        art.size = Vector2(39 * u, 23 * u)
        art.mouse_filter = Control.MOUSE_FILTER_IGNORE
        card.add_child(art)
    var cost := Label.new()
    cost.text = spec[2]
    cost.theme_type_variation = &"CostLabel"
    cost.position = Vector2(3 * u, 1 * u)
    card.add_child(cost)
    var nm := Label.new()
    nm.text = spec[1]
    nm.theme_type_variation = &"CardPlateLabel"
    nm.position = Vector2(12 * u, 6 * u)
    card.add_child(nm)
    var rl := Label.new()
    rl.text = spec[3]
    rl.theme_type_variation = &"CardPlateLabel"
    # two 11-unit lines in the 22-unit box: Godot's default 3-unit line spacing pushed the second line's descenders onto
    # the box edge (LOOK 2), so the spacing closes by one unit and the block is centred in the box
    rl.add_theme_constant_override("line_spacing", -1 * u)
    rl.add_theme_constant_override("paragraph_spacing", 0)
    rl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    rl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
    # anchored to a fixed box: a Label sized before the theme reaches it is sized for Godot's default font and never
    # shrinks back (the pixel table's rules ran out of the card, LOOK 3); anchors re-fit it once the kit font applies
    var rb := Control.new()
    rb.position = Vector2(6 * u, 45 * u)
    rb.size = Vector2(39 * u, 22 * u)
    rb.mouse_filter = Control.MOUSE_FILTER_IGNORE
    card.add_child(rb)
    rb.add_child(rl)
    rl.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)

# a fixed-size icon with a number centred on it (the block shield)
func _numbered(th: Theme, row: Control, id: String, text: String, u: int) -> void:
    if not th.has_icon(id, "UiKit"):
        return
    var tex := th.get_icon(id, "UiKit")
    var box := Control.new()
    box.custom_minimum_size = tex.get_size()
    box.size_flags_vertical = Control.SIZE_SHRINK_CENTER
    row.add_child(box)
    var ic := TextureRect.new()
    ic.texture = tex
    box.add_child(ic)
    var l := Label.new()
    l.text = text
    l.theme_type_variation = &"CostLabel"
    l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
    box.add_child(l)
    l.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)

func _pile(th: Theme, row: Control, id: String, count: String, u: int) -> void:
    if not th.has_icon(id, "UiKit"):
        return
    var box := Control.new()
    # the badge starts at x 12; a two-digit count makes it 16 wide (in a 26-wide box it ran into the next control, LOOK 2)
    box.custom_minimum_size = Vector2((26 + 4 * max(0, count.length() - 1)) * u, 26 * u)
    row.add_child(box)
    var ic := TextureRect.new()
    ic.texture = th.get_icon(id, "UiKit")
    box.add_child(ic)
    if th.has_stylebox("panel", "CountBadge"):
        var bd := PanelContainer.new()
        bd.theme_type_variation = &"CountBadge"
        var bl := Label.new()
        bl.text = count
        bl.theme_type_variation = &"CountBadgeLabel"
        bl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
        bd.add_child(bl)
        bd.position = Vector2(12 * u, 14 * u)
        box.add_child(bd)
