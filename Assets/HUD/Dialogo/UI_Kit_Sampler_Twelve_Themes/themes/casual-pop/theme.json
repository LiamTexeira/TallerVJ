{
  "schema": "csaf-uikit-theme/1",
  "id": "casual-pop",
  "name": "Casual Pop",
  "note": "Kit 7 (2026-10-18): a chunky, bright, flat candy theme for casual and party games. A 2-unit grape ink outline in each family's deep tone, 4-unit rounded corners, a solid ink drop shadow, and the kit's own frame idea: a gloss shine strip under the top of every raised body and a thick 2-unit lip along its bottom (geometry.gloss + geometry.lip, added to the generator for this kit); a pressed button loses both and reads pushed in. Cream panels, a bubblegum primary, a tangerine danger family, candy bars, a round coin. Dark grape ink for every caption (white on candy fills fails 4.5:1). Every text-on-fill pair is re-measured by the gate.",
  "geometry": {
    "border": 2,
    "radius": 4,
    "shadow": 1,
    "hdScale": 3,
    "style": "flat",
    "ornaments": false,
    "gloss": true,
    "lip": 2,
    "coin": "disc"
  },
